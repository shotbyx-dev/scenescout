<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Android 12+ counterpart to backup_rules.xml: the user-pasted Google
         API key lives in the "scenescout" prefs and must never leave the
         device. Planner projects (planner.json) stay backed up. -->
    <cloud-backup>
        <exclude domain="sharedpref" path="scenescout.xml"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="scenescout.xml"/>
    </device-transfer>
</data-extraction-rules>
